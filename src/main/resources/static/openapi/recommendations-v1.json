{
  "openapi": "3.1.0",
  "info": {
    "title": "Prediction recommendations via Gateway",
    "description": "Internal API for short-term computational demand estimates.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/recommendations/v1/recommendations": {
      "post": {
        "tags": [
          "Recommendations"
        ],
        "summary": "Recommend",
        "operationId": "recommend_v1_recommendations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Recommendation"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceProblem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/Problem"
                    },
                    {
                      "$ref": "#/components/schemas/InferenceProblem"
                    }
                  ],
                  "title": "Response 422 Recommend V1 Recommendations Post"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InferenceProblem"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente o inválido"
          },
          "403": {
            "description": "Rol insuficiente"
          },
          "413": {
            "description": "Cuerpo demasiado grande"
          },
          "504": {
            "description": "Timeout del Gateway"
          }
        },
        "description": "Responsabilidad de Prediction. JWT ADMIN/OPERATOR; máximo 2 MB, timeout 30 s y sin reintentos."
      }
    },
    "/api/recommendations/v1/energy": {
      "post": {
        "tags": [
          "Recommendations"
        ],
        "summary": "Energy",
        "operationId": "energy_v1_energy_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnergyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnergyResult"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "JWT ausente o inválido"
          },
          "403": {
            "description": "Rol insuficiente"
          },
          "413": {
            "description": "Cuerpo demasiado grande"
          },
          "504": {
            "description": "Timeout del Gateway"
          }
        },
        "description": "Responsabilidad de Prediction. JWT ADMIN/OPERATOR; máximo 2 MB, timeout 30 s y sin reintentos."
      }
    }
  },
  "components": {
    "schemas": {
      "Check": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "unknown"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "title": "Check"
      },
      "EnergyRequest": {
        "properties": {
          "origin": {
            "type": "string",
            "enum": [
              "observed",
              "simulated",
              "estimated"
            ],
            "title": "Origin"
          },
          "samples": {
            "items": {
              "$ref": "#/components/schemas/PowerSample"
            },
            "type": "array",
            "maxItems": 10000,
            "minItems": 2,
            "title": "Samples"
          },
          "emissionFactorKgPerKwh": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Emissionfactorkgperkwh"
          },
          "emissionFactorSource": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Emissionfactorsource"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin",
          "samples"
        ],
        "title": "EnergyRequest"
      },
      "EnergyResult": {
        "properties": {
          "origin": {
            "type": "string",
            "title": "Origin"
          },
          "energyKwh": {
            "type": "number",
            "title": "Energykwh"
          },
          "co2eKg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Co2Ekg"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          },
          "emissionFactorKgPerKwh": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emissionfactorkgperkwh"
          },
          "emissionFactorSource": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Emissionfactorsource"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "default": "trapezoidal_power_integration"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "origin",
          "energyKwh",
          "co2eKg",
          "start",
          "end",
          "emissionFactorKgPerKwh",
          "emissionFactorSource",
          "warnings"
        ],
        "title": "EnergyResult"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InferenceProblem": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "details"
        ],
        "title": "InferenceProblem"
      },
      "Policy": {
        "properties": {
          "mode": {
            "type": "string",
            "const": "demonstration",
            "title": "Mode",
            "default": "demonstration"
          },
          "cpuLowPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Cpulowpercent",
            "default": 30
          },
          "cpuHighPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Cpuhighpercent",
            "default": 80
          },
          "memoryMaxPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Memorymaxpercent",
            "default": 85
          },
          "latencyP95MaxMs": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Latencyp95Maxms",
            "default": 500
          },
          "errorRateMaxPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Errorratemaxpercent",
            "default": 1
          },
          "freshnessSeconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Freshnessseconds",
            "default": 300
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Policy"
      },
      "PowerSample": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "watts": {
            "type": "number",
            "maximum": 1000000000000.0,
            "minimum": 0.0,
            "title": "Watts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "timestamp",
          "watts"
        ],
        "title": "PowerSample"
      },
      "Problem": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "Problem"
      },
      "Recommendation": {
        "properties": {
          "recommendationId": {
            "type": "string",
            "title": "Recommendationid"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Generatedat"
          },
          "predictionId": {
            "type": "string",
            "title": "Predictionid"
          },
          "inputDatasetId": {
            "type": "string",
            "title": "Inputdatasetid"
          },
          "predictedCpuPercent": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Predictedcpupercent"
          },
          "telemetry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Telemetry"
              },
              {
                "type": "null"
              }
            ]
          },
          "resource": {
            "$ref": "#/components/schemas/Resource"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_evaluable",
              "blocked",
              "eligible_for_review"
            ],
            "title": "Status"
          },
          "action": {
            "type": "string",
            "enum": [
              "none",
              "maintain",
              "review_capacity_reduction",
              "review_capacity_increase"
            ],
            "title": "Action"
          },
          "executionAllowed": {
            "type": "boolean",
            "const": false,
            "title": "Executionallowed",
            "default": false
          },
          "policy": {
            "$ref": "#/components/schemas/Policy"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/Check"
            },
            "type": "array",
            "title": "Checks"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "recommendationId",
          "generatedAt",
          "predictionId",
          "inputDatasetId",
          "predictedCpuPercent",
          "telemetry",
          "resource",
          "status",
          "action",
          "policy",
          "checks",
          "warnings"
        ],
        "title": "Recommendation"
      },
      "RecommendationRequest": {
        "properties": {
          "dataset": {
            "additionalProperties": true,
            "type": "object",
            "title": "Dataset"
          },
          "telemetry": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Telemetry"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "dataset"
        ],
        "title": "RecommendationRequest"
      },
      "Resource": {
        "properties": {
          "type": {
            "type": "string",
            "const": "node",
            "title": "Type"
          },
          "id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Id"
          },
          "cluster": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Cluster"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "type",
          "id",
          "cluster"
        ],
        "title": "Resource"
      },
      "Telemetry": {
        "properties": {
          "resource": {
            "$ref": "#/components/schemas/Resource"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "title": "Observedat"
          },
          "origin": {
            "type": "string",
            "enum": [
              "observed",
              "simulated"
            ],
            "title": "Origin"
          },
          "memoryPercent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Memorypercent"
          },
          "latencyP95Ms": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Latencyp95Ms"
          },
          "errorRatePercent": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Errorratepercent"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "resource",
          "observedAt",
          "origin"
        ],
        "title": "Telemetry"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
